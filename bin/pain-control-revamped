#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh
set -eu

pain_control_revamped_self="$0"
case "${pain_control_revamped_self}" in
*/*) ;;
*) pain_control_revamped_self="$(command -v -- "${pain_control_revamped_self}")" ;;
esac
pain_control_revamped_lib="$(cd "${pain_control_revamped_self%/*}/../lib" && pwd)" || exit 1
for pain_control_revamped_inherited in $(env | sed -n -e 's/^\(REVAMPED_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(PAIN_CONTROL_REVAMPED_[A-Za-z0-9_]*_LOADED\)=.*/\1/p'); do
  case "${pain_control_revamped_inherited}" in
  REVAMPED_TEST_*) continue ;;
  *) unset "${pain_control_revamped_inherited}" ;;
  esac
done
REVAMPED_LIB="${pain_control_revamped_lib}"

# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${REVAMPED_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/pain.sh
. "${REVAMPED_LIB}/pain.sh"

pain_control_revamped_interface() {
  # shellcheck disable=SC2034
  REVAMPED_UI_NAME=pain-control-revamped REVAMPED_UI_VERSION="${PAIN_CONTROL_REVAMPED_VERSION}" REVAMPED_UI_TAGLINE="pane and window keys for tmux"
  if [ -n "${PAIN_CONTROL_REVAMPED_ACCENT:-}" ]; then
    # shellcheck disable=SC2034
    REVAMPED_UI_ACCENT_CHOICE="${PAIN_CONTROL_REVAMPED_ACCENT}" REVAMPED_UI_ACCENT_NAME=PAIN_CONTROL_REVAMPED_ACCENT
  fi
  # shellcheck source=SCRIPTDIR/../lib/cli.sh
  . "${REVAMPED_LIB}/cli.sh"
  # shellcheck source=SCRIPTDIR/../lib/doctor.sh
  . "${REVAMPED_LIB}/doctor.sh"
}

pain_control_revamped_usage() {
  pain_control_revamped_interface
  revamped_cli_usage_error "$1"
}

pain_control_revamped_help() {
  revamped_cli_help_page <<'HELP'
pain-control-revamped - pane and window keys for tmux

usage:
  pain-control-revamped apply     bind every key now
  pain-control-revamped list      print every binding apply would make
  pain-control-revamped doctor    check this machine
  pain-control-revamped version   print the version
  pain-control-revamped help      print this page

options:
  --json           list prints one JSON object
  --theme NAME     the look: kodougu, catppuccin-mocha, catppuccin-latte,
                   dracula, nord, gruvbox, tokyo-night or mono
  --SETTING VALUE  any tmux option below, named with dashes, such as
                   --resize 3 or --join-key J

environment:
  PAIN_CONTROL_REVAMPED_SETTING  any tmux option below in capitals, such as
                                 PAIN_CONTROL_REVAMPED_RESIZE
  PAIN_CONTROL_REVAMPED_THEME    the look, when --theme is not given
  PAIN_CONTROL_REVAMPED_ACCENT   a colour such as #CBA6F7 for the accent
  KODOUGU_THEME                  the family look, when neither is given
  KODOUGU_ACCENT                 the family accent, when the tool's is unset
  NO_COLOR                       turn colour off

tmux options:
  @pain_control_revamped_resize                cells per resize (default 5)
  @pain_control_revamped_new_window_path       true opens c in the pane's
                                               folder (default true)
  @pain_control_revamped_disabled_keys         keys to leave alone, such as
                                               "| -"
  @pain_control_revamped_no_wrap               on stops at the edge (off)
  @pain_control_revamped_vim_navigation        on sends C-h to C-l to vim (off)
  @pain_control_revamped_vim_pattern           the process names vim
                                               navigation matches
  @pain_control_revamped_pane_titles           on shows titles on borders (off)
  @pain_control_revamped_smart_split_key       split the longer side (*)
  @pain_control_revamped_join_key              join a pane (@)
  @pain_control_revamped_break_key             break the pane out (!)
  @pain_control_revamped_swap_prev_key         swap pane up ({)
  @pain_control_revamped_swap_next_key         swap pane down (})
  @pain_control_revamped_promote_key           promote to main (+)
  @pain_control_revamped_mark_key              mark the pane (m)
  @pain_control_revamped_swap_mark_key         swap with the mark (=)
  @pain_control_revamped_sync_key              toggle pane sync (unbound)
  @pain_control_revamped_swap_window_left_key  swap window left (unbound)
  @pain_control_revamped_swap_window_right_key swap window right (unbound)
  @pain_control_revamped_move_window_key       move to a session (unbound)
  @pain_control_revamped_kill_window_key       kill the window (unbound)
  @pain_control_revamped_layout_even_h_key     even-horizontal (unbound)
  @pain_control_revamped_layout_even_v_key     even-vertical (unbound)
  @pain_control_revamped_layout_main_v_key     main-vertical (unbound)
  @pain_control_revamped_respawn_key           respawn the pane (unbound)
  @pain_control_revamped_capture_key           save the scrollback (unbound)
  @pain_control_revamped_pane_name_key         name the pane (unbound)
  @pain_control_revamped_scratch_key           scratch popup (unbound)
  @pain_control_revamped_scratch_command       the popup's command (a shell)
  @revamped_theme                              the family look (kodougu)

notes:
  The entry point runs apply once when tmux loads the plugin, and every
  binding goes to tmux in one call. Each key is checked against the tmux
  version, and every binding carries a note that prefix ? shows.

examples:
  pain-control-revamped list
  pain-control-revamped --disabled-keys '| -' apply
  pain-control-revamped doctor
HELP
}

pain_control_revamped_version() {
  pain_control_revamped_tmux=$(tmux -V 2>/dev/null) || pain_control_revamped_tmux=missing
  printf '%s %s\n' pain-control-revamped "${PAIN_CONTROL_REVAMPED_VERSION}"
  printf 'tmux: %s\n' "${pain_control_revamped_tmux#tmux }"
}

pain_control_revamped_doctor_ps() {
  pain_control_revamped_doctor_ps_path=$(command -v ps 2>/dev/null) || pain_control_revamped_doctor_ps_path=""
  if [ -n "${pain_control_revamped_doctor_ps_path}" ]; then
    revamped_doctor_line ps ok "${pain_control_revamped_doctor_ps_path}"
    return 0
  fi
  revamped_doctor_line ps warn "vim navigation needs it"
}

pain_control_revamped_doctor() {
  revamped_doctor_tmux
  pain_control_revamped_doctor_ps
  revamped_doctor_gum
  revamped_doctor_core_tools awk sed tr grep
  revamped_doctor_finish
  [ "${REVAMPED_DOCTOR_MISSING}" -eq 0 ] || exit 1
}

pain_control_revamped_list() {
  pain_control_revamped_plan
  if [ -n "${pain_control_revamped_json}" ]; then
    pain_control_revamped_json
    return 0
  fi
  pain_control_revamped_lines
}

pain_control_revamped_apply_command() {
  pain_control_revamped_apply
  pain_control_revamped_count=$(pain_control_revamped_bindings)
  printf 'Applied. %s keys are bound.\n' "${pain_control_revamped_count}"
}

pain_control_revamped_menu() {
  revamped_cli_require_terminal
  pain_control_revamped_choice=$(revamped_cli_menu "List the bindings" "Apply them now" "Check this machine" "Help")
  case "${pain_control_revamped_choice}" in
  "List the bindings") pain_control_revamped_list ;;
  "Apply them now") pain_control_revamped_apply_command ;;
  "Check this machine") pain_control_revamped_doctor ;;
  *) pain_control_revamped_help ;;
  esac
}

pain_control_revamped_dispatch() {
  case "${1:-}" in
  doctor) pain_control_revamped_doctor ;;
  version | --version | -V) pain_control_revamped_version ;;
  help | --help | -h) pain_control_revamped_help ;;
  list) pain_control_revamped_list ;;
  "") pain_control_revamped_menu ;;
  *) revamped_cli_usage_error "unknown command '$1'" ;;
  esac
}

pain_control_revamped_known() {
  [ "$1" != --theme ] || return 0
  pain_control_revamped_known_name=$(pain_control_revamped_setting_name "$1")
  [ -n "${pain_control_revamped_known_name}" ] || pain_control_revamped_usage "unknown option '$1'"
}

pain_control_revamped_set() {
  pain_control_revamped_set_upper=$(printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]')
  export "PAIN_CONTROL_REVAMPED_${pain_control_revamped_set_upper}=$2"
}

pain_control_revamped_option() {
  pain_control_revamped_option_name=$(pain_control_revamped_setting_name "$1")
  [ -n "${pain_control_revamped_option_name}" ] || pain_control_revamped_usage "unknown option '$1'"
  pain_control_revamped_set "${pain_control_revamped_option_name}" "$2"
}

pain_control_revamped_main() {
  pain_control_revamped_theme="${PAIN_CONTROL_REVAMPED_THEME:-}" pain_control_revamped_json="" pain_control_revamped_count=$# pain_control_revamped_rest=0
  while [ "${pain_control_revamped_count}" -gt 0 ]; do
    pain_control_revamped_arg="$1"
    shift
    pain_control_revamped_count=$((pain_control_revamped_count - 1))
    case "${pain_control_revamped_rest}:${pain_control_revamped_arg}" in
    1:*) set -- "$@" "${pain_control_revamped_arg}" ;;
    0:--) pain_control_revamped_rest=1 ;;
    0:--json) pain_control_revamped_json=1 ;;
    0:-h | 0:-V | 0:--help | 0:--version) set -- "$@" "${pain_control_revamped_arg}" ;;
    0:--theme=*) pain_control_revamped_theme="${pain_control_revamped_arg#--theme=}" ;;
    0:--*=*) pain_control_revamped_option "${pain_control_revamped_arg%%=*}" "${pain_control_revamped_arg#*=}" ;;
    0:--*)
      pain_control_revamped_known "${pain_control_revamped_arg}"
      [ "${pain_control_revamped_count}" -gt 0 ] || pain_control_revamped_usage "option '${pain_control_revamped_arg}' needs a value"
      if [ "${pain_control_revamped_arg}" = --theme ]; then
        pain_control_revamped_theme="$1"
      else
        pain_control_revamped_option "${pain_control_revamped_arg}" "$1"
      fi
      shift
      pain_control_revamped_count=$((pain_control_revamped_count - 1))
      ;;
    0:-?*) pain_control_revamped_usage "unknown option '${pain_control_revamped_arg}'" ;;
    *) set -- "$@" "${pain_control_revamped_arg}" ;;
    esac
  done
  pain_control_revamped_run "${pain_control_revamped_theme}" "$@"
}

pain_control_revamped_run() {
  pain_control_revamped_run_theme="$1"
  shift
  [ -z "${pain_control_revamped_json}" ] || [ "${1:-}" = list ] || pain_control_revamped_usage "option '--json' works only with list"
  case "${1:-}" in
  apply) pain_control_revamped_apply ;;
  *)
    pain_control_revamped_interface
    revamped_cli_start "${pain_control_revamped_run_theme}"
    pain_control_revamped_dispatch "$@"
    ;;
  esac
}

pain_control_revamped_main "$@"
